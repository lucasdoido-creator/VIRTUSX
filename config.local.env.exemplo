# Copie este arquivo para "config.local.env" (na mesma pasta) e preencha.
# Ele fica só no seu computador: está no .gitignore e nunca vai para o GitHub.

# Chave da API do Claude (console.anthropic.com). Usada só quando a IA grátis não resolver.
ANTHROPIC_API_KEY=

# Travas de gasto com o Claude (em dólares). Ao atingir, o sistema segue só com IA grátis e regras.
BRAIN_MONTHLY_CAP_USD=2
BRAIN_DAILY_CAP_USD=0.20

# Modelo usado nas decisões (o mais barato por padrão).
BRAIN_DECISION_MODEL=claude-haiku-5-5

# IA grátis local (Ollama). Instale em ollama.com e rode: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# Posição da sua sede no mapa (padrão: centro de São Paulo).
HQ_LAT=-23.5505
HQ_LNG=-46.6333

# WhatsApp oficial (Meta WhatsApp Cloud API) — veja docs/PLATAFORMA.md, seção "WhatsApp".
# Sem estes 4 campos, o produção mostra "integração pendente" e NÃO finge enviar nada.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Senha que você inventa e repete no painel da Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v24.0

# Endereço público do servidor (domínio ou túnel HTTPS) — usado nos sites de cada país, hreflang e sitemap.
# Sem ele, os sites funcionam aqui, mas o Google não consegue encontrá-los.
PUBLIC_BASE_URL=

# Sentinela (monitor de segurança): chave da Claude SEPARADA e teto próprio. Pode colar a chave pela tela (Saúde).
MONITOR_ANTHROPIC_API_KEY=
MONITOR_MONTHLY_CAP_USD=5
MONITOR_DAILY_CAP_USD=0.50
# Opcional: para o Sentinela abrir a correção aprovada como issue no GitHub (@claude cria o PR, os testes rodam, você decide o merge).
MONITOR_GITHUB_TOKEN=
MONITOR_GITHUB_REPO=lucasdoido-creator/VIRTUSX
